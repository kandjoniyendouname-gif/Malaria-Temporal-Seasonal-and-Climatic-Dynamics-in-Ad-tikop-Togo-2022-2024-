# 2. Fonction de corrélation Spearman (avec lag)
def spearman_corr(df, x, y, lag=0):
    """
    x = variable météo
    y = cas de paludisme
    lag = décalage temporel (en mois)
    """
    if lag > 0:
        df = df.copy()
        df[x] = df[x].shift(lag)
        df = df.dropna()

    rho, p = spearmanr(df[x], df[y])
    return rho, p


