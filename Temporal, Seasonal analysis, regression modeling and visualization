# Two anova test for association
df["Saison"] = df["Saison"].astype("category")
df["Année"] = df["Année"].astype("category")
import statsmodels.api as sm
from statsmodels.formula.api import ols
from scipy.stats import shapiro, levene
from patsy import dmatrix

def two_way_anova_prevalence(df, outcome):

    print(f"\n===== TWO-WAY ANOVA POUR : {outcome} =====")

    # Modèle linéaire
    formula = f"Q('{outcome}') ~ C(Saison) * C(Année)"
    model = ols(
        formula,
        data=df
    ).fit()

    # Table ANOVA (Type II)
    anova_table = sm.stats.anova_lm(model, typ=2)
    print("\n--- Table ANOVA ---")
    print(anova_table)

    # Tests d’hypothèses
    print("\n--- Vérification des hypothèses ---")

    # Normalité des résidus
    shapiro_p = shapiro(model.resid)[1]
    print(f"Shapiro-Wilk (résidus) p-value = {shapiro_p:.4f}")

    # Homogénéité des variances
    groups = [
        group[outcome].values
        for _, group in df.groupby(["Saison", "Année"])
    ]
    levene_p = levene(*groups)[1]
    print(f"Levene (variances) p-value = {levene_p:.4f}")

    return model, anova_table
