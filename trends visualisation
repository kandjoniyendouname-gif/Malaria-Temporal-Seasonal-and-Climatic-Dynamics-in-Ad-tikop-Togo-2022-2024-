import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
file_name = "Clean_data_for_M._ATTISSO 06 01 2026.xls"
df = pd.read_excel(file_name)
df.head()
# Dictionnaire pour convertir les mois en chiffres
mois_map = {
    "Janvier": 1, "Février": 2, "Mars": 3, "Avril": 4,
    "Mai": 5, "Juin": 6, "Juillet": 7, "Août": 8,
    "Septembre": 9, "Octobre": 10, "Novembre": 11, "Décembre": 12
}

df["Mois_num"] = df["Mois"].map(mois_map)

df["date"] = pd.to_datetime(
    dict(year=df["Année"], month=df["Mois_num"], day=1)
)

df = df.sort_values("date")

variables_utiles = [
    "date",
    "Total_cas confirmés",
    "Prevalence_total",
    "Cas_confirmés_<5ans",
    "Cas_confirmés_>5ans_avec_FE",
    "Prevalence_<5ans",
    "Prevalence_>5ans_avec_FE"
]

print(df.columns)
df[["date", "Total_cas confirmés"]].head() # Only display valid columns for now
plt.figure(figsize=(12,5))
plt.plot(df["date"], df["Total_cas confirmés"], marker="o")
plt.title("Évolution mensuelle des cas confirmés de paludisme (2022–2024)")
plt.xlabel("Date")
plt.ylabel("Nombre de cas confirmés")
plt.grid(True)
plt.show()
plt.figure(figsize=(12,5))
plt.plot(df["date"], df["Prevalence_total"], marker="o", color="darkgreen")
plt.title("Évolution mensuelle de la prévalence du paludisme (2022–2024)")
plt.xlabel("Date")
plt.ylabel("Prévalence (%)")
plt.grid(True)
plt.show()

plt.figure(figsize=(12,5))
plt.plot(df["date"], df["Cas_confirmés_<5ans"], label="< 5 ans", marker="o")
plt.plot(df["date"], df["Cas_confirmés_>5ans_avec_FE"], label="≥ 5 ans (incluant FE)", marker="o")

plt.title("Évolution mensuelle des cas confirmés par groupe d’âge")
plt.xlabel("Date")
plt.ylabel("Nombre de cas confirmés")
plt.legend()
plt.grid(True)
plt.show()

plt.figure(figsize=(12,5))
plt.plot(df["date"], df["Prevalence_<5ans"], label="< 5 ans", marker="o")
plt.plot(df["date"], df["Prevalence_>5ans_avec_FE"], label="≥ 5 ans (incluant FE)", marker="o")

plt.title("Évolution mensuelle de la prévalence par groupe d’âge")
plt.xlabel("Date")
plt.ylabel("Prévalence (%)")
plt.legend()
plt.grid(True)
plt.show()

resume_annuel = df.groupby("Année").agg(
    cas_confirmes_moy=("Total_cas confirmés", "mean"),
    prevalence_moy=("Prevalence_total", "mean"),
    prevalence_min=("Prevalence_total", "min"),
    prevalence_max=("Prevalence_total", "max")
).round(2)

resume_annuel

